# Copie para .env somente em desenvolvimento. Em produção, prefira as
# variáveis secretas do provedor de hospedagem. Nunca versione o .env real.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=bigua.seudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bigua.seudominio.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# Banco: sqlite3 para piloto pequeno ou postgresql para produção recomendada.
DB_ENGINE=postgresql
DB_NAME=bigua
DB_USER=bigua
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
SQLITE_NAME=mydatabase

# Deixe False quando os jobs forem executados por cron/worker externo.
ENABLE_BACKGROUND_SCHEDULER=False

# Token de acesso permanente (ou temporário, em dev) do WhatsApp Cloud API
WHATSAPP_TOKEN=

# ID do número de telefone cadastrado na Cloud API
WHATSAPP_PHONE_NUMBER_ID=

# ID da conta WhatsApp Business (WABA), necessário para gerenciar templates
WHATSAPP_WABA_ID=

# Token que você mesmo escolhe e cadastra no painel da Meta para
# validar o handshake do webhook (GET /whatsapp/webhook/?hub.verify_token=...)
WHATSAPP_VERIFY_TOKEN=

# Versão da Graph API (opcional, default já é v23.0)
WHATSAPP_API_VERSION=v23.0
